{
  "schema_version": "rpent.handoff-experiment-config/v1",
  "experiment_id": "${RPENT_HANDOFF_EXPERIMENT_ID}",
  "output_root": "${RPENT_HANDOFF_OUTPUT_ROOT}",
  "repeats": "${RPENT_HANDOFF_REPEATS}",
  "tasks": [
    {
      "suite": "${RPENT_HANDOFF_SUITE}",
      "task": "${RPENT_HANDOFF_TASK}",
      "seeds": [0, 1, 2],
      "target_id": "${RPENT_HANDOFF_TARGET_ID}",
      "target_description": "${RPENT_HANDOFF_TARGET_DESCRIPTION}",
      "skill_name": "pick",
      "skill_prompt": "${RPENT_HANDOFF_SKILL_PROMPT}",
      "training_target_label": "primitive_success",
      "label_source": "primitive_heuristic",
      "task_config": null,
      "reset_id_template": null
    }
  ],
  "conditions": [
    {
      "name": "controlled-direct-pi0",
      "execution_layer": "controlled",
      "method": "direct_frozen_pi0",
      "handoff_enabled": true,
      "handoff_config": "../policies/direct_pi0.json",
      "feature_set": "deployment_full",
      "evidence": "success_and_failure",
      "decision": "direct",
      "uncertainty": "mean_only",
      "hierarchy": "local_governor"
    },
    {
      "name": "controlled-canonical",
      "execution_layer": "controlled",
      "method": "fixed_canonical_precontact",
      "handoff_enabled": true,
      "handoff_config": "../policies/canonical_staging.json",
      "feature_set": "target_relative",
      "evidence": "success_and_failure",
      "decision": "fixed",
      "uncertainty": "mean_only",
      "hierarchy": "local_governor"
    },
    {
      "name": "controlled-fixed-distance",
      "execution_layer": "controlled",
      "method": "fixed_distance",
      "handoff_enabled": true,
      "handoff_config": "../policies/fixed_distance.json",
      "feature_set": "target_relative",
      "evidence": "success_and_failure",
      "decision": "fixed",
      "uncertainty": "mean_only",
      "hierarchy": "local_governor"
    },
    {
      "name": "controlled-positive-retrieval",
      "execution_layer": "controlled",
      "method": "positive_nearest_success",
      "handoff_enabled": true,
      "handoff_config": "../policies/positive_retrieval.json",
      "feature_set": "target_relative",
      "evidence": "success_only",
      "decision": "retrieval",
      "uncertainty": "mean_only",
      "hierarchy": "local_governor"
    },
    {
      "name": "controlled-positive-support",
      "execution_layer": "controlled",
      "method": "positive_support_region",
      "handoff_enabled": true,
      "handoff_config": "../policies/positive_support_region.json",
      "feature_set": "target_relative",
      "evidence": "success_only",
      "decision": "support_region",
      "uncertainty": "mean_only",
      "hierarchy": "local_governor"
    },
    {
      "name": "controlled-competence-threshold",
      "execution_layer": "controlled",
      "method": "competence_probability_threshold",
      "handoff_enabled": true,
      "handoff_config": "../policies/competence_threshold.json",
      "model_artifact": "${RPENT_HANDOFF_MODEL_FULL}",
      "feature_set": "deployment_full",
      "evidence": "success_and_failure",
      "decision": "threshold",
      "uncertainty": "conservative",
      "hierarchy": "local_governor"
    },
    {
      "name": "controlled-competence-projection",
      "execution_layer": "controlled",
      "method": "competence_projection",
      "handoff_enabled": true,
      "handoff_config": "../policies/competence_projection.json",
      "model_artifact": "${RPENT_HANDOFF_MODEL_FULL}",
      "feature_set": "deployment_full",
      "evidence": "success_and_failure",
      "decision": "projection",
      "uncertainty": "mean_only",
      "hierarchy": "local_governor"
    },
    {
      "name": "controlled-ours-conservative",
      "execution_layer": "controlled",
      "method": "outcome_calibrated_switching",
      "handoff_enabled": true,
      "handoff_config": "../policies/outcome_switching_conservative.json",
      "model_artifact": "${RPENT_HANDOFF_MODEL_FULL}",
      "feature_set": "deployment_full",
      "evidence": "success_and_failure",
      "decision": "online_switching",
      "uncertainty": "conservative",
      "hierarchy": "local_governor"
    },
    {
      "name": "ablation-uncertainty-mean",
      "execution_layer": "controlled",
      "method": "outcome_calibrated_switching",
      "handoff_enabled": true,
      "handoff_config": "../policies/outcome_switching_mean.json",
      "model_artifact": "${RPENT_HANDOFF_MODEL_FULL}",
      "feature_set": "deployment_full",
      "evidence": "success_and_failure",
      "decision": "online_switching",
      "uncertainty": "mean_only",
      "hierarchy": "local_governor"
    },
    {
      "name": "ablation-representation-absolute",
      "execution_layer": "controlled",
      "method": "outcome_calibrated_switching",
      "handoff_enabled": true,
      "handoff_config": "../policies/outcome_switching_absolute.json",
      "model_artifact": "${RPENT_HANDOFF_MODEL_ABSOLUTE}",
      "feature_set": "absolute",
      "evidence": "success_and_failure",
      "decision": "online_switching",
      "uncertainty": "conservative",
      "hierarchy": "local_governor"
    },
    {
      "name": "ablation-representation-relative",
      "execution_layer": "controlled",
      "method": "outcome_calibrated_switching",
      "handoff_enabled": true,
      "handoff_config": "../policies/outcome_switching_target_relative.json",
      "model_artifact": "${RPENT_HANDOFF_MODEL_RELATIVE}",
      "feature_set": "target_relative",
      "evidence": "success_and_failure",
      "decision": "online_switching",
      "uncertainty": "conservative",
      "hierarchy": "local_governor"
    },
    {
      "name": "ablation-representation-relative-visual",
      "execution_layer": "controlled",
      "method": "outcome_calibrated_switching",
      "handoff_enabled": true,
      "handoff_config": "../policies/outcome_switching_target_relative_visual.json",
      "model_artifact": "${RPENT_HANDOFF_MODEL_RELATIVE_VISUAL}",
      "feature_set": "target_relative_visual",
      "evidence": "success_and_failure",
      "decision": "online_switching",
      "uncertainty": "conservative",
      "hierarchy": "local_governor"
    },
    {
      "name": "full-original-harness",
      "execution_layer": "full_agent",
      "method": "original_harness",
      "handoff_enabled": false,
      "handoff_config": null,
      "feature_set": "deployment_full",
      "evidence": "success_and_failure",
      "decision": "direct",
      "uncertainty": "mean_only",
      "hierarchy": "planner_mediated"
    },
    {
      "name": "full-local-governor",
      "execution_layer": "full_agent",
      "method": "outcome_calibrated_switching",
      "handoff_enabled": true,
      "handoff_config": "../policies/outcome_switching_conservative.json",
      "model_artifact": "${RPENT_HANDOFF_MODEL_FULL}",
      "feature_set": "deployment_full",
      "evidence": "success_and_failure",
      "decision": "online_switching",
      "uncertainty": "conservative",
      "hierarchy": "local_governor"
    },
    {
      "name": "posthoc-oracle-upper-bound",
      "execution_layer": "gate0",
      "method": "posthoc_oracle_upper_bound",
      "handoff_enabled": false,
      "handoff_config": null,
      "feature_set": "deployment_full",
      "evidence": "success_and_failure",
      "decision": "oracle",
      "uncertainty": "mean_only",
      "hierarchy": "not_applicable",
      "parameters": {"posthoc_only": true, "matched_context_required": true}
    }
  ],
  "runtime": {
    "env_name": "libero",
    "libero_type": "pro",
    "max_episode_steps": 10000,
    "cuda_device": 0,
    "env_endpoint": null,
    "vla_endpoint": null,
    "sam3_endpoint": null,
    "pi05_checkpoint_path": "${PI05_CHECKPOINT_PATH}",
    "sam3_checkpoint_path": "${SAM3_CHECKPOINT_PATH}",
    "pi05_checkpoint_id": "${RPENT_PI05_CHECKPOINT_ID}",
    "sam3_checkpoint_id": "${RPENT_SAM3_CHECKPOINT_ID}"
  },
  "planner": {
    "backend": "api",
    "model": null,
    "base_url": null,
    "max_turns": 100,
    "max_tokens": 8192,
    "planner_timeout_s": 1200,
    "claude_code_max_budget_usd": null,
    "no_images": false
  },
  "source_revision": null,
  "metadata": {"status": "experimentally_unverified", "oracle_is_posthoc": true}
}
