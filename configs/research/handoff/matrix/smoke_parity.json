{
  "schema_version": "rpent.handoff-experiment-config/v1",
  "experiment_id": "${RPENT_HANDOFF_EXPERIMENT_ID}-smoke",
  "output_root": "${RPENT_HANDOFF_OUTPUT_ROOT}",
  "repeats": 1,
  "tasks": [
    {
      "suite": "${RPENT_HANDOFF_SUITE}",
      "task": "${RPENT_HANDOFF_TASK}",
      "seeds": [0],
      "target_id": "${RPENT_HANDOFF_TARGET_ID}",
      "target_description": "${RPENT_HANDOFF_TARGET_DESCRIPTION}",
      "skill_name": "pick",
      "skill_prompt": "${RPENT_HANDOFF_SKILL_PROMPT}",
      "training_target_label": "primitive_success",
      "label_source": "primitive_heuristic",
      "task_config": null,
      "reset_id_template": null
    }
  ],
  "conditions": [
    {
      "name": "smoke-controlled-direct-pi0",
      "execution_layer": "controlled",
      "method": "direct_frozen_pi0",
      "handoff_enabled": true,
      "handoff_config": "../policies/direct_pi0.json",
      "feature_set": "deployment_full",
      "evidence": "success_and_failure",
      "decision": "direct",
      "uncertainty": "mean_only",
      "hierarchy": "local_governor"
    },
    {
      "name": "smoke-original-harness",
      "execution_layer": "full_agent",
      "method": "original_harness",
      "handoff_enabled": false,
      "handoff_config": null,
      "feature_set": "deployment_full",
      "evidence": "success_and_failure",
      "decision": "direct",
      "uncertainty": "mean_only",
      "hierarchy": "planner_mediated"
    }
  ],
  "runtime": {
    "env_name": "libero",
    "libero_type": "pro",
    "max_episode_steps": 10000,
    "cuda_device": 0,
    "env_endpoint": null,
    "vla_endpoint": null,
    "sam3_endpoint": null,
    "pi05_checkpoint_path": "${PI05_CHECKPOINT_PATH}",
    "sam3_checkpoint_path": "${SAM3_CHECKPOINT_PATH}",
    "pi05_checkpoint_id": "${RPENT_PI05_CHECKPOINT_ID}",
    "sam3_checkpoint_id": "${RPENT_SAM3_CHECKPOINT_ID}"
  },
  "runtime_probes": [
    {
      "name": "read-only",
      "path": "${RPENT_RUNTIME_PROBE_READONLY}",
      "required_observed_facts": [
        "env.endpoint_health",
        "env.reset_identity",
        "vla.endpoint_health",
        "vla.model_checkpoint_identity",
        "sam3.endpoint_health",
        "sam3.model_checkpoint_identity"
      ]
    },
    {
      "name": "vla-inference",
      "path": "${RPENT_RUNTIME_PROBE_INFERENCE}",
      "required_observed_facts": [
        "vla.actual_action_shape",
        "vla.actual_chunk_size"
      ]
    },
    {
      "name": "sam3-inference",
      "path": "${RPENT_RUNTIME_PROBE_SAM3}",
      "required_observed_facts": [
        "sam3.current_observation_acceptance"
      ]
    }
  ],
  "planner": {
    "backend": "api",
    "model": "${RPENT_PLANNER_MODEL}",
    "base_url": "${RPENT_PLANNER_BASE_URL}",
    "max_turns": 100,
    "max_tokens": 8192,
    "planner_timeout_s": 1200,
    "claude_code_max_budget_usd": null,
    "no_images": false
  },
  "source_revision": "${RPENT_SOURCE_REVISION}",
  "metadata": {
    "purpose": "pre-Gate0 tiny smoke and Original Harness parity only",
    "status": "experimentally_unverified"
  }
}
