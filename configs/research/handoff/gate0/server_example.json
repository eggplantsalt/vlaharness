{
  "schema_version": "rpent.handoff-gate0-job/v1",
  "output_dir": "${RPENT_HANDOFF_OUTPUT_ROOT}/gate0/${RPENT_GATE0_RUN_ID}",
  "adapter_factory": "robots.libero.handoff_experiments:build_gate0_adapter_bundle",
  "adapter_config": {
    "runtime": {
      "env_name": "libero",
      "libero_type": "pro",
      "max_episode_steps": 10000,
      "cuda_device": 0,
      "env_endpoint": null,
      "vla_endpoint": null,
      "sam3_endpoint": null,
      "pi05_checkpoint_path": "${PI05_CHECKPOINT_PATH}",
      "sam3_checkpoint_path": "${SAM3_CHECKPOINT_PATH}",
      "pi05_checkpoint_id": "${RPENT_PI05_CHECKPOINT_ID}",
      "sam3_checkpoint_id": "${RPENT_SAM3_CHECKPOINT_ID}"
    },
    "handoff_config": "configs/research/handoff/policies/gate0_direct_perception.json",
    "vla_method": "pi0_pick",
    "setup_target": {
      "raw_observation_key": "${RPENT_GATE0_TARGET_POSITION_KEY}",
      "flat_indices": [0, 1, 2],
      "frame": "libero_world",
      "unit": "m",
      "provider_id": "configured-libero-setup-key/v1",
      "reset_info_key": null
    },
    "tool_defaults": {
      "stage_gripper": -1.0,
      "action_scale": 0.05,
      "stage_tolerance_m": 0.000001
    },
    "labeler_factory": null,
    "training_target_label": "primitive_success"
  },
  "gate0": {
    "sampler": {
      "mode": "latin_hypercube",
      "relative_x_m": {"minimum": -0.08, "maximum": 0.08, "grid_count": 5},
      "relative_y_m": {"minimum": -0.08, "maximum": 0.08, "grid_count": 5},
      "relative_z_m": {"minimum": -0.02, "maximum": 0.12, "grid_count": 5},
      "standoff_m": {"minimum": 0.0, "maximum": 0.12, "grid_count": 4},
      "wrist_yaw_rad": {"minimum": -0.5, "maximum": 0.5, "grid_count": 5},
      "wrist_pitch_rad": {"minimum": -0.3, "maximum": 0.3, "grid_count": 3},
      "approach_axis_world": [0.0, 0.0, 1.0],
      "random_samples": 64,
      "repeats": 3,
      "seed": 20260808,
      "maximum_total_trials": 100000
    },
    "staging_tolerance_m": 0.012,
    "staging_step_m": 0.025,
    "max_staging_steps": 80,
    "max_staging_distance_m": 0.5,
    "max_staging_time_s": 30.0
  },
  "run_id": "${RPENT_GATE0_RUN_ID}",
  "episode_prefix": "gate0",
  "suite": "${RPENT_GATE0_SUITE}",
  "task_id": "${RPENT_GATE0_TASK}",
  "seed": "${RPENT_GATE0_SEED}",
  "target_id": "${RPENT_GATE0_TARGET_ID}",
  "target_description": "${RPENT_GATE0_TARGET_DESCRIPTION}",
  "skill_name": "pick",
  "skill_prompt": "${RPENT_GATE0_SKILL_PROMPT}",
  "vla_kwargs": {"max_chunks": 25},
  "controller_method": "gate0_direct_frozen_pi0",
  "controller_implementation_version": "rpent-libero-gate0/v1",
  "checkpoint_id": "${RPENT_PI05_CHECKPOINT_ID}",
  "configuration_id": null,
  "source_revision": null,
  "metadata": {
    "status": "experimentally_unverified",
    "setup_target_is_privileged": true,
    "online_target_is_current_observation_sam3": true
  }
}
